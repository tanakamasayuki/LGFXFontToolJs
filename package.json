{
  "name": "lgfx-font-tool",
  "version": "0.1.0",
  "description": "JavaScript toolkit for embedded bitmap fonts - decode, encode, convert, render and generate.",
  "type": "module",
  "license": "MIT",
  "author": "TANAKA Masayuki",
  "sideEffects": false,
  "main": "dist/lgfx-font-tool.js",
  "module": "dist/lgfx-font-tool.js",
  "browser": "dist/lgfx-font-tool.min.js",
  "unpkg": "dist/lgfx-font-tool.min.js",
  "jsdelivr": "dist/lgfx-font-tool.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/lgfx-font-tool.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/fonts/data",
    "types",
    "CHANGELOG.md",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "font",
    "bitmap-font",
    "u8g2",
    "gfxfont",
    "adafruit-gfx",
    "bdf",
    "vlw",
    "lovyangfx",
    "embedded"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanakamasayuki/LGFXFontToolJs.git"
  },
  "bugs": {
    "url": "https://github.com/tanakamasayuki/LGFXFontToolJs/issues"
  },
  "homepage": "https://tanakamasayuki.github.io/LGFXFontToolJs/",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "build": "node scripts/build.js",
    "types": "tsc -p tsconfig.types.json",
    "smoke:dist": "node scripts/smoke-dist.js",
    "prepack": "npm run build && npm run types",
    "preversion": "npm run check && node scripts/check-releasable.js",
    "version": "node scripts/sync-version.js",
    "typecheck": "tsc --noEmit",
    "lint:layers": "node scripts/check-layers.js",
    "lint:locales": "node scripts/check-locales.js",
    "check": "npm run test && npm run typecheck && npm run lint:layers && npm run lint:locales",
    "build:site": "node scripts/build-site.js",
    "extract-fonts": "node scripts/extract-fonts.js",
    "oracle": "node oracle/gen-fonts-table.js && arduino-cli compile --profile host --build-path .cache/oracle-build oracle/oracle_dump && node oracle/run-oracle.js .cache/oracle-build/oracle_dump.ino.out",
    "oracle:encoded": "node oracle/gen-encoded-fonts.js && arduino-cli compile --profile host --build-path .cache/oracle-enc-build oracle/oracle_encoded && node oracle/run-oracle.js .cache/oracle-enc-build/oracle_encoded.ino.out test/fixtures/oracle-encoded",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
